# Copy to .env and fill in. Never commit .env.
PROVIDER=gemini
GOOGLE_API_KEY=your-key-from-aistudio.google.com
# Check https://ai.google.dev/gemini-api/docs/pricing for which models are on the free tier.
LLM_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2-preview
# Refusal threshold. Re-tune after building the Gemini index: python -m eval.run_eval --sweep
MIN_SCORE=0.70
TOP_K=4
# Abuse limits for the public /ask endpoint
RATE_LIMIT_PER_MINUTE=10
DAILY_ASK_LIMIT=400
